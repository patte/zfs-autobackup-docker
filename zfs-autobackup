#!/usr/bin/env bash
set -euo pipefail

# Prefer podman, fall back to docker; ENGINE overrides the choice
if [[ -n "${ENGINE:-}" ]]; then
  engine=$ENGINE
elif command -v podman >/dev/null 2>&1; then
  engine=podman
elif command -v docker >/dev/null 2>&1; then
  engine=docker
else
  echo "error: neither podman nor docker found in PATH" >&2
  exit 1
fi

# TAG selects the image tag: latest (default), pre, or a version like 3.3;
# IMAGE overrides the whole image reference (e.g. a locally built image)
TAG="${TAG:-latest}"
IMAGE="${IMAGE:-ghcr.io/patte/zfs-autobackup:$TAG}"

args=(
  --rm
  --privileged
  -v /dev:/dev
  -v ./known_hosts:/root/.ssh/known_hosts
)

if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
  args+=(--env "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" -v "$SSH_AUTH_SOCK:$SSH_AUTH_SOCK")
fi

# ZAB_SRC mounts a local zfs_autobackup checkout over the installed package
# (via PYTHONPATH), so source edits apply without rebuilding the image
if [[ -n "${ZAB_SRC:-}" ]]; then
  args+=(-v "$ZAB_SRC:/zab-src:ro" --env PYTHONPATH=/zab-src)
fi

# DOCKER_ARGS: extra arguments for the container engine (word split)
# shellcheck disable=SC2086
sudo "$engine" run "${args[@]}" ${DOCKER_ARGS:-} "$IMAGE" "$@"
