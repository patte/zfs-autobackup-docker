#!/usr/bin/env bash
set -euo pipefail

# Prefer podman, fall back to docker; ENGINE overrides the choice
if [[ -n "${ENGINE:-}" ]]; then
  engine=$ENGINE
elif command -v podman >/dev/null 2>&1; then
  engine=podman
elif command -v docker >/dev/null 2>&1; then
  engine=docker
else
  echo "error: neither podman nor docker found in PATH" >&2
  exit 1
fi

# TAG selects the image tag: latest (default), pre, or a version like 3.3;
# IMAGE overrides the whole image reference (e.g. a locally built image)
TAG="${TAG:-latest}"
IMAGE="${IMAGE:-ghcr.io/patte/zfs-autobackup:$TAG}"

args=(
  --rm
  --cap-drop ALL --cap-add SYS_ADMIN --cap-add DAC_OVERRIDE
  --security-opt no-new-privileges=true
  --device /dev/zfs
)

# SSH_DIR: an ssh dir providing keys, known_hosts and config, ~/.ssh by default.
# If unset an existing ./known_hosts file is used instead
# SSH_DIR= forces no ssh dir.
if [[ -z ${SSH_DIR+set} && ! -f known_hosts && -d ~/.ssh ]]; then
  SSH_DIR=~/.ssh
fi
if [[ -n "${SSH_DIR:-}" ]]; then
  ssh_dir=$(cd "$SSH_DIR" && pwd)
  args+=(-v "$ssh_dir:/ssh-host:ro")
  echo "[wrapper] using ssh dir $ssh_dir" >&2
elif [[ -f known_hosts ]]; then
  args+=(-v ./known_hosts:/root/.ssh/known_hosts)
  echo "[wrapper] using ./known_hosts" >&2
fi

if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
  args+=(--env "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" -v "$SSH_AUTH_SOCK:$SSH_AUTH_SOCK")
fi

# ZAB_SRC mounts a local zfs_autobackup checkout over the installed package
# (via PYTHONPATH), so source edits apply without rebuilding the image
if [[ -n "${ZAB_SRC:-}" ]]; then
  args+=(-v "$ZAB_SRC:/zab-src:ro" --env PYTHONPATH=/zab-src)
fi

# DOCKER_ARGS: extra arguments for the container engine (word split)
# shellcheck disable=SC2086
sudo "$engine" run "${args[@]}" ${DOCKER_ARGS:-} "$IMAGE" "$@"
