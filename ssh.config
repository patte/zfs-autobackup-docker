# ssh config shipped in the image at /root/.ssh/config.
#
# Optional: to customise ssh (port, jump host, user, ...), copy this file, add
# Host blocks like the example below and mount your copy to /root/.ssh/config:
#
# Host backup
#     HostName backup.example.com
#     Port 2222
#     User zfsbackup
#     ProxyJump jump.example.com
#
# (then --ssh-target backup and ssh-keyscan -p 2222 backup.example.com >> known_hosts)

# Keep connections alive and reuse one connection for zfs-autobackup's many ssh calls
Host *
    ServerAliveInterval 60
    ServerAliveCountMax 15
    ControlMaster auto
    ControlPath /root/.ssh/cm-%r@%h:%p
    ControlPersist 48h
